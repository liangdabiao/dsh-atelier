{
  "name": "dsh-atelier",
  "version": "0.1.0",
  "description": "母题工作台：Agent 原生创作链路 + TikHub 信息来源与数据反馈双通道 + apiz 生图。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "gallery",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "content-studio", "tikhub"],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "selftest": "node scripts/selftest.mjs",
    "extract:specs": "node scripts/extract-platform-specs.mjs",
    "prepack": "npm run build"
  }
}
